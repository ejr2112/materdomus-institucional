<Project Sdk="Microsoft.NET.Sdk.BlazorWebAssembly">

  <PropertyGroup>
    <TargetFramework>net9.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
  </PropertyGroup>

  <ItemGroup>
    <Compile Remove="MaterDomus.Tests/**" />
    <Content Remove="MaterDomus.Tests/**" />
    <EmbeddedResource Remove="MaterDomus.Tests/**" />
    <None Remove="MaterDomus.Tests/**" />
    <Compile Remove="tools/**" />
    <Content Remove="tools/**" />
    <EmbeddedResource Remove="tools/**" />
    <None Remove="tools/**" />
  </ItemGroup>

  <!-- JSON-LD e o HTML de /produtos saem de products.json para não divergir do catálogo. -->
  <Target Name="GenerateVitrineSeo"
          BeforeTargets="BeforeBuild"
          Inputs="$(MSBuildProjectDirectory)/wwwroot/data/products.json;$(MSBuildProjectDirectory)/wwwroot/index.html;$(MSBuildProjectDirectory)/tools/VitrineSeoGen/VitrineSeo.cs;$(MSBuildProjectDirectory)/tools/VitrineSeoGen/CatalogMarkup.cs;$(MSBuildProjectDirectory)/tools/VitrineSeoGen/ProductPages.cs;$(MSBuildProjectDirectory)/tools/VitrineSeoGen/StaticPages.cs;$(MSBuildProjectDirectory)/tools/VitrineSeoGen/LlmsTxt.cs;$(MSBuildProjectDirectory)/tools/VitrineSeoGen/Program.cs"
          Outputs="$(MSBuildProjectDirectory)/wwwroot/produtos.html;$(MSBuildProjectDirectory)/wwwroot/sobre.html;$(MSBuildProjectDirectory)/wwwroot/contato.html;$(MSBuildProjectDirectory)/wwwroot/fornecedores.html;$(MSBuildProjectDirectory)/wwwroot/privacidade.html;$(MSBuildProjectDirectory)/wwwroot/frete-e-trocas.html;$(MSBuildProjectDirectory)/wwwroot/404.html;$(MSBuildProjectDirectory)/wwwroot/llms.txt;$(MSBuildProjectDirectory)/wwwroot/llms-full.txt;$(MSBuildProjectDirectory)/wwwroot/data/vitrine-itemlist.json;$(MSBuildProjectDirectory)/wwwroot/data/vitrine-meta.json;$(MSBuildProjectDirectory)/wwwroot/sitemap.xml;$(MSBuildProjectDirectory)/wwwroot/staticwebapp.config.json"
          Condition="'$(DesignTimeBuild)' != 'true'">
    <Message Importance="high" Text="Gerando JSON-LD e metadados da vitrine a partir de products.json" />
    <Exec Command="dotnet build &quot;$(MSBuildProjectDirectory)/tools/VitrineSeoGen/VitrineSeoGen.csproj&quot; -c $(Configuration) --nologo" />
    <Exec Command="dotnet exec &quot;$(MSBuildProjectDirectory)/tools/VitrineSeoGen/bin/$(Configuration)/net9.0/VitrineSeoGen.dll&quot; &quot;$(MSBuildProjectDirectory)&quot;" />
  </Target>

  <ItemGroup>
    <AssemblyAttribute Include="System.Runtime.CompilerServices.InternalsVisibleToAttribute">
      <_Parameter1>MaterDomus.Tests</_Parameter1>
    </AssemblyAttribute>
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.Components.WebAssembly" Version="9.0.4" />
    <PackageReference Include="Microsoft.AspNetCore.Components.WebAssembly.DevServer" Version="9.0.4" PrivateAssets="all" />
  </ItemGroup>

</Project>
