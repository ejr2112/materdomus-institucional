@using MaterDomus.Web.Models
@using MaterDomus.Web.Services
@using MaterDomus.Web.Helpers
@inject FavoritesService FavoritesService

<article role="article" aria-label="@Product.Name" class="product-card @(Product.ComingSoon ? "product-card--coming-soon" : "product-card--available")">
    <div class="product-card__image-wrapper">
        @if (HasGallery)
        {
            <div class="@GalleryClass"
                 data-active-index="@_slideIndex"
                 @ontouchstart="OnTouchStart"
                 @ontouchend="OnTouchEnd">
                @for (var i = 0; i < _slides.Length; i++)
                {
                    var index = i;
                    var slide = _slides[index];
                    <img src="@slide.Src"
                         alt="@slide.Alt"
                         class="@SlideClass(index, slide.HoverTarget)"
                         width="1200"
                         height="1200"
                         loading="@(slide.Lifestyle && !slide.Eager ? "lazy" : null)"
                         decoding="@(slide.Lifestyle && !slide.Eager ? "async" : null)"
                         aria-hidden="@(_slideIndex == index ? null : "true")"
                         onerror="@SlideOnError(slide)" />
                }
                <div class="product-card__dots" role="group" aria-label="Fotos do produto">
                    @for (var i = 0; i < _slides.Length; i++)
                    {
                        var index = i;
                        <button type="button"
                                class="@DotClass(index)"
                                aria-label="@($"Ver foto {index + 1} de {_slides.Length}")"
                                aria-pressed="@(index == _slideIndex ? "true" : "false")"
                                aria-current="@(index == _slideIndex ? "true" : null)"
                                @onclick="() => SelectSlide(index)"
                                @onclick:stopPropagation="true"></button>
                    }
                </div>
                <button type="button"
                        class="product-card__arrow product-card__arrow--prev"
                        aria-label="Foto anterior"
                        @onclick="ShowPrevious"
                        @onclick:stopPropagation="true">‹</button>
                <button type="button"
                        class="product-card__arrow product-card__arrow--next"
                        aria-label="Próxima foto"
                        @onclick="ShowNext"
                        @onclick:stopPropagation="true">›</button>
            </div>
        }
        else
        {
            <img src="@ProductHelpers.DisplayImageUrl(Product.ImageUrl)"
                 alt="@Product.Name"
                 class="product-card__image"
                 onerror="this.onerror=null;this.src='images/placeholder-product.png'" />
        }
        @if (Product.ComingSoon)
        {
            <span class="product-card__badge">Em breve</span>
        }
    </div>
    <div class="product-card__body">
        <span class="product-card__category">@Product.Category</span>
        <h3 class="product-card__name">@Product.Name</h3>
        <p class="product-card__price">@FormatPrice(Product.Price)</p>
        @if (Product.ComingSoon)
        {
            <p class="product-card__coming-soon">Disponível em breve na Amazon</p>
        }
        <p class="product-card__description">@TruncateDescription(Product.Description)</p>
    </div>
    <div class="product-card__actions">
        @if (ProductHelpers.ShowAmazonCta(Product))
        {
            <a href="@Product.AmazonUrl"
               target="_blank"
               rel="noopener noreferrer"
               class="product-card__amazon-btn">
                Comprar na Amazon
            </a>
        }
        <button class="product-card__details-btn"
                type="button"
                aria-label="@($"Ver detalhes {Product.Name}")"
                @onclick="() => OnVerDetalhes.InvokeAsync(Product)">
            Ver detalhes
        </button>
        <button class="product-card__favorite-btn @(IsFav ? "product-card__favorite-btn--active" : "")"
                aria-pressed="@IsFav.ToString().ToLower()"
                aria-label="@(IsFav ? "Remover dos favoritos" : "Favoritar produto")"
                @onclick="ToggleFavorite"
                type="button">
            @(IsFav ? "♥" : "♡")
        </button>
    </div>
</article>

@code {
    [Parameter] public Product Product { get; set; } = default!;

    [Parameter] public EventCallback<Product> OnVerDetalhes { get; set; }

    private bool IsFav => FavoritesService.IsFavorite(Product.Id);

    private const double SwipeThresholdPx = 40;

    private SlideView[] _slides = Array.Empty<SlideView>();
    private string? _boundProductId;
    private int _slideIndex;
    private bool _userChoseSlide;
    private double? _touchStartX;
    private double? _touchStartY;

    private bool HasGallery => _slides.Length > 1;

    /// <summary>
    /// O hover antecipa a 2ª ambientada só enquanto a 1ª segue selecionada
    /// e o usuário ainda não escolheu um slide. Ao sair, volta a 1ª — a foto
    /// de fundo branco não entra nesse preview.
    /// </summary>
    private bool HoverPreviewEnabled =>
        _slideIndex == 0 && !_userChoseSlide && HasHoverTarget;

    private bool HasHoverTarget
    {
        get
        {
            foreach (var slide in _slides)
            {
                if (slide.HoverTarget)
                    return true;
            }

            return false;
        }
    }

    private string GalleryClass =>
        HoverPreviewEnabled
            ? "product-card__gallery"
            : "product-card__gallery is-browsing";

    /// <summary>
    /// Foto da mini-galeria: ambientadas primeiro; a de fundo branco por último.
    /// <paramref name="Eager"/> marca a 1ª ambientada, visível na carga.
    /// </summary>
    private readonly record struct SlideView(string Src, string Alt, bool Lifestyle, bool HoverTarget, bool Eager);

    protected override void OnParametersSet()
    {
        var lifestyle = (Product.LifestyleImages ?? Array.Empty<ProductLifestyleImage>())
            .Where(image => image is not null && !string.IsNullOrWhiteSpace(image.Url))
            .ToArray();

        if (lifestyle.Length == 0)
        {
            _slides = new[]
            {
                new SlideView(
                    ProductHelpers.DisplayImageUrl(Product.ImageUrl),
                    Product.Name,
                    Lifestyle: false,
                    HoverTarget: false,
                    Eager: true)
            };
        }
        else
        {
            var slides = new SlideView[lifestyle.Length + 1];
            for (var i = 0; i < lifestyle.Length; i++)
            {
                slides[i] = new SlideView(
                    lifestyle[i].Url,
                    lifestyle[i].Alt ?? string.Empty,
                    Lifestyle: true,
                    HoverTarget: i == 1,
                    Eager: i == 0);
            }

            slides[lifestyle.Length] = new SlideView(
                ProductHelpers.DisplayImageUrl(Product.ImageUrl),
                Product.Name,
                Lifestyle: false,
                HoverTarget: false,
                Eager: false);
            _slides = slides;
        }

        if (_boundProductId != Product.Id)
        {
            _boundProductId = Product.Id;
            _slideIndex = 0;
            _userChoseSlide = false;
            _touchStartX = null;
            _touchStartY = null;
        }
        else if (_slideIndex >= _slides.Length)
        {
            _slideIndex = 0;
        }
    }

    private string SlideClass(int index, bool hoverTarget)
    {
        var cls = "product-card__image product-card__slide";
        if (index == _slideIndex)
            cls += " product-card__slide--active";
        if (hoverTarget)
            cls += " product-card__slide--hover-target";
        return cls;
    }

    /// <summary>
    /// Ambientada quebrada cai na foto principal e, se essa também falhar, no placeholder.
    /// A foto de fundo branco mantém o fallback direto para o placeholder.
    /// </summary>
    private string SlideOnError(SlideView slide)
    {
        if (!slide.Lifestyle)
            return "this.onerror=null;this.src='images/placeholder-product.png'";

        var fallback = ProductHelpers.DisplayImageUrl(Product.ImageUrl)
            .Replace("\\", "\\\\", StringComparison.Ordinal)
            .Replace("'", "\\'", StringComparison.Ordinal);
        return "this.onerror=function(){this.onerror=null;this.src='images/placeholder-product.png'};this.src='"
            + fallback + "'";
    }

    private string DotClass(int index) =>
        index == _slideIndex
            ? "product-card__dot product-card__dot--active"
            : "product-card__dot";

    private void SelectSlide(int index)
    {
        if ((uint)index >= (uint)_slides.Length)
            return;

        _userChoseSlide = true;
        _slideIndex = index;
    }

    private void ShowPrevious()
    {
        if (_slides.Length <= 1)
            return;

        _userChoseSlide = true;
        _slideIndex = (_slideIndex - 1 + _slides.Length) % _slides.Length;
    }

    private void ShowNext()
    {
        if (_slides.Length <= 1)
            return;

        _userChoseSlide = true;
        _slideIndex = (_slideIndex + 1) % _slides.Length;
    }

    private void OnTouchStart(TouchEventArgs e)
    {
        if (e.Touches.Length == 0)
            return;

        _touchStartX = e.Touches[0].ClientX;
        _touchStartY = e.Touches[0].ClientY;
    }

    private void OnTouchEnd(TouchEventArgs e)
    {
        if (_touchStartX is null || e.ChangedTouches.Length == 0)
        {
            _touchStartX = null;
            _touchStartY = null;
            return;
        }

        var startX = _touchStartX.Value;
        var startY = _touchStartY ?? e.ChangedTouches[0].ClientY;
        _touchStartX = null;
        _touchStartY = null;

        var dx = e.ChangedTouches[0].ClientX - startX;
        var dy = e.ChangedTouches[0].ClientY - startY;
        if (Math.Abs(dx) < SwipeThresholdPx || Math.Abs(dx) <= Math.Abs(dy))
            return;

        if (dx < 0)
            ShowNext();
        else
            ShowPrevious();
    }

    /// <summary>
    /// Truncates the description to 120 characters followed by "..." if longer.
    /// Pure static function — delegates to ProductHelpers.
    /// </summary>
    public static string TruncateDescription(string description)
        => ProductHelpers.TruncateDescription(description) ?? string.Empty;

    /// <summary>
    /// Formats a decimal price as "R$ X,XX" using pt-BR culture.
    /// Pure static function — delegates to ProductHelpers.
    /// </summary>
    public static string FormatPrice(decimal price)
        => ProductHelpers.FormatPrice(price);

    private void ToggleFavorite()
    {
        FavoritesService.Toggle(Product.Id);
        StateHasChanged();
    }
}
