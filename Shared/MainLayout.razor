@inherits LayoutComponentBase
@using Microsoft.AspNetCore.Components.Routing
@inject IJSRuntime JS
<PageViewTracker />
<header class="header">
    <div class="container">
        <div class="logo">
            <img src="images/logo.png" alt="Mater Domus" />
        </div>

        <nav>
            <NavLink href="/" Match="NavLinkMatch.All">Início</NavLink>
            <NavLink href="/produtos">Produtos</NavLink>
            <NavLink href="/sobre">Sobre</NavLink>
            <NavLink href="/fornecedores">Fornecedores</NavLink>
            <NavLink href="/contato">Contato</NavLink>
        </nav>
    </div>
</header>

<main>
    @Body
</main>

<footer class="footer">
    <p>© @DateTime.Now.Year Mater Domus</p>
    <nav class="footer-links" aria-label="Informações legais">
        <a href="/privacidade">Política de Privacidade</a>
        <button type="button"
                class="footer-cookies-btn"
                @onclick="OpenCookiePreferences">
            Preferências de cookies
        </button>
    </nav>
</footer>

<BottomNav />

@code {
    private Task OpenCookiePreferences() =>
        JS.InvokeVoidAsync("materDomusOpenCookiePreferences").AsTask();
}