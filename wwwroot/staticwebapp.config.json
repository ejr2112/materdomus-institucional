      "route": "/contato/",
      "redirect": "/contato",
      "statusCode": 301
    },
    {
      "route": "/fornecedores",
      "rewrite": "/fornecedores.html"
    },
    {
      "route": "/fornecedores/",
      "redirect": "/fornecedores",
      "statusCode": 301
    },
    {
      "route": "/privacidade",
      "rewrite": "/privacidade.html"
    },
    {
      "route": "/privacidade/",
      "redirect": "/privacidade",
      "statusCode": 301
    },
    {
      "route": "/frete-e-trocas",
