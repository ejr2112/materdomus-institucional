{
  "routes": [
    {
      "route": "/produtos",
      "rewrite": "/produtos.html"
    }
  ],
  "navigationFallback": {
    "rewrite": "/index.html",
    "exclude": [
      "/images/*.{png,jpg,jpeg,gif,svg,ico}",
      "/css/*",
      "/js/*",
      "/_framework/*",
      "/lib/*",
      "/favicon.ico",
      "/robots.txt",
      "/sitemap.xml",
      "/manifest.webmanifest"
    ]
  }
}
