@page "/produtos"
@using MaterDomus.Web.Models
@using MaterDomus.Web.Services
@using MaterDomus.Web.Helpers
@inject IProductCatalogService ProductCatalogService
@inject FavoritesService FavoritesService
@implements IDisposable

<HeadContent>
    <link rel="stylesheet" href="css/produtos.css" />
</HeadContent>

<section class="produtos-page">
    <h1>Produtos</h1>
    <p class="page-subtitle">Conheça os produtos MaterDomus disponíveis na Amazon.</p>

    @if (_isLoading)
    {
        <SkeletonLoader Message="@_ariaMessage" ShowProlongedIndicator="_isProlonged" />
    }
    else if (_hasError)
    {
        <div class="produtos-state produtos-error">
            <div class="produtos-state__icon">⚠️</div>
            <p class="produtos-state__title">Não foi possível carregar os produtos.</p>
            <p class="produtos-state__message">Verifique sua conexão e tente novamente.</p>
            <button class="btn-retry" @onclick="RetryLoad" type="button">Tentar novamente</button>
        </div>
    }
    else
    {
        <!-- Filter bar -->
        <div class="filter-bar">
            <input class="filter-bar__search"
                   type="search"
                   placeholder="Buscar produtos..."
                   aria-label="Buscar produtos"
                   @bind="_searchText"
                   @bind:event="oninput" />

            <select class="filter-bar__select"
                    aria-label="Filtrar por categoria"
                    @bind="_selectedCategory">
                <option value="">Todas as categorias</option>
                @foreach (var category in _allProducts.Select(p => p.Category).Distinct().OrderBy(c => c))
                {
                    <option value="@category">@category</option>
                }
            </select>

            <button class="filter-bar__favorites-btn @(_showFavoritesOnly ? "filter-bar__favorites-btn--active" : "")"
                    type="button"
                    aria-pressed="@_showFavoritesOnly.ToString().ToLower()"
                    @onclick="() => _showFavoritesOnly = !_showFavoritesOnly">
                ♥ Favoritos
            </button>
        </div>

        <!-- Favorites counter badge -->
        @if (FavoritesService.Count > 0)
        {
            <div class="favorites-badge">
                <span class="favorites-badge__count">@FavoritesService.Count</span>
                produto@(FavoritesService.Count == 1 ? "" : "s") favoritado@(FavoritesService.Count == 1 ? "" : "s")
            </div>
        }

        <!-- Product grid or empty states -->
        @if (!_allProducts.Any())
        {
            <div class="produtos-state produtos-empty">
                <div class="produtos-state__icon">📦</div>
                <p class="produtos-state__title">Nenhum produto disponível no momento.</p>
                <p class="produtos-state__message">Volte em breve para conferir novidades.</p>
            </div>
        }
        else if (_showFavoritesOnly && !FilteredProducts.Any())
        {
            <div class="produtos-state produtos-empty">
                <div class="produtos-state__icon">♡</div>
                <p class="produtos-state__title">Nenhum produto favoritado.</p>
                <p class="produtos-state__message">Clique no ícone de coração em um produto para adicioná-lo aos favoritos.</p>
            </div>
        }
        else if (!FilteredProducts.Any())
        {
            <div class="produtos-state produtos-empty">
                <div class="produtos-state__icon">🔍</div>
                <p class="produtos-state__title">Nenhum produto encontrado.</p>
                <p class="produtos-state__message">Tente ajustar os filtros ou o termo de busca.</p>
            </div>
        }
        else
        {
            <div class="products-grid products-grid--fade-in">
                @foreach (var product in FilteredProducts)
                {
                    <ProductCard Product="product" OnVerDetalhes="AbrirDetalhes" />
                }
            </div>
        }
    }

    @* Faixa de aviso quando o produto acionado não pôde ser resolvido pelo Id
       (Req 1.6): a grade permanece visível e o modal não é aberto. *@
    @if (_detailUnavailable)
    {
        <div class="produtos-detail-unavailable" role="alert">
            Detalhes do produto indisponíveis.
        </div>
    }
</section>

@* Visão de detalhes (modal) hospedada fora da grade: sobreposição sobre a grade,
   preservando busca/filtro/favoritos (Req 6.7). *@
<ProductDetail Product="_selectedProduct" IsOpen="_isDetailOpen" OnClose="FecharDetalhes" />

@code {
    private IReadOnlyList<Product> _allProducts = Array.Empty<Product>();
    private bool _isLoading = true;
    private bool _hasError = false;
    private bool _isProlonged = false;
    private string _ariaMessage = "Carregando produtos...";
    private string _searchText = "";
    private string _selectedCategory = "";
    private bool _showFavoritesOnly = false;

    // Estado da visão de detalhes (modal). Independente da busca/filtro/favoritos.
    private Product? _selectedProduct;
    private bool _isDetailOpen;
    private bool _detailUnavailable;

    private CancellationTokenSource _cts = new();

    private PeriodicTimer? _prolongedTimer;
    private Task? _prolongedMonitorTask;

    private IEnumerable<Product> FilteredProducts =>
        _allProducts
            .Where(p => string.IsNullOrEmpty(_searchText) ||
                        p.Name.Contains(_searchText, StringComparison.OrdinalIgnoreCase) ||
                        p.Description.Contains(_searchText, StringComparison.OrdinalIgnoreCase))
            .Where(p => string.IsNullOrEmpty(_selectedCategory) ||
                        p.Category == _selectedCategory)
            .Where(p => !_showFavoritesOnly || FavoritesService.IsFavorite(p.Id));

    protected override async Task OnInitializedAsync()
    {
        FavoritesService.OnChanged += OnFavoritesChanged;
        await LoadProductsAsync();
    }

    private async Task LoadProductsAsync()
    {
        // Troca imediata do estado de erro pelo esqueleto (Requisito 6.2: em até 1s).
        // O StateHasChanged explícito garante a re-renderização do esqueleto antes do
        // primeiro await, tornando a transição erro -> esqueleto imediata no retry.
        _isLoading = true;
        _hasError = false;
        _isProlonged = false;
        _ariaMessage = "Carregando produtos...";
        StateHasChanged();

        try
        {
            _cts.Cancel();
            _cts.Dispose();
            _cts = new CancellationTokenSource();

            StartProlongedMonitor();

            var loadTask = ProductCatalogService.GetProductsAsync();
            var timeoutTask = Task.Delay(TimeSpan.FromSeconds(10), _cts.Token);

            var completed = await Task.WhenAny(loadTask, timeoutTask);

            if (completed == timeoutTask)
            {
                _hasError = true;
                _ariaMessage = "Não foi possível carregar os produtos.";
            }
            else
            {
                _allProducts = await loadTask;
                _ariaMessage = "Produtos carregados.";
            }
        }
        catch (Exception)
        {
            _hasError = true;
            _ariaMessage = "Não foi possível carregar os produtos.";
        }
        finally
        {
            StopProlongedMonitor();
            _isLoading = false;
            _isProlonged = false;
        }
    }

    /// <summary>
    /// Inicia um temporizador que reavalia a fase de carregamento a cada segundo.
    /// Ativa <c>_isProlonged</c> quando o tempo decorrido entra na faixa de 3–10s
    /// (fase Prolonged, Requisito 6.3), via StateHasChanged no contexto de renderização.
    /// </summary>
    private void StartProlongedMonitor()
    {
        StopProlongedMonitor();

        var startedAt = DateTime.UtcNow;
        var timer = new PeriodicTimer(TimeSpan.FromSeconds(1));
        _prolongedTimer = timer;

        _prolongedMonitorTask = Task.Run(async () =>
        {
            try
            {
                while (await timer.WaitForNextTickAsync())
                {
                    var elapsedSeconds = (DateTime.UtcNow - startedAt).TotalSeconds;
                    var phase = LoadingStateHelpers.DerivePhase(elapsedSeconds, completed: false, errored: false);
                    var prolonged = phase == LoadingPhase.Prolonged;

                    if (prolonged != _isProlonged)
                    {
                        _isProlonged = prolonged;
                        await InvokeAsync(StateHasChanged);
                    }
                }
            }
            catch (OperationCanceledException)
            {
                // Temporizador descartado; encerramento normal.
            }
            catch (ObjectDisposedException)
            {
                // Temporizador descartado; encerramento normal.
            }
        });
    }

    /// <summary>
    /// Interrompe e descarta o temporizador de carregamento prolongado, se ativo.
    /// </summary>
    private void StopProlongedMonitor()
    {
        _prolongedTimer?.Dispose();
        _prolongedTimer = null;
        _prolongedMonitorTask = null;
    }

    private async Task RetryLoad()
    {
        await LoadProductsAsync();
    }

    /// <summary>
    /// Abre a visão de detalhes do produto acionado a partir do <c>ProductCard</c>.
    /// Resolve o produto por <c>Id</c> em <c>_allProducts</c>; se não puder ser
    /// resolvido, mantém a grade visível e sinaliza indisponibilidade sem abrir o
    /// modal (Req 1.2, 1.6).
    /// </summary>
    private void AbrirDetalhes(Product product)
    {
        var resolved = _allProducts.FirstOrDefault(p => p.Id == product.Id);
        if (resolved is null)
        {
            _detailUnavailable = true;
            return;
        }

        _selectedProduct = resolved;
        _isDetailOpen = true;
        _detailUnavailable = false;
    }

    /// <summary>
    /// Fecha a visão de detalhes e zera o estado do modal, retornando à grade
    /// (Req 1.5). A restauração de foco é conduzida pelo próprio <c>ProductDetail</c>.
    /// </summary>
    private void FecharDetalhes()
    {
        _isDetailOpen = false;
        _selectedProduct = null;
    }

    private void OnFavoritesChanged()
    {
        StateHasChanged();
    }

    public void Dispose()
    {
        FavoritesService.OnChanged -= OnFavoritesChanged;
        StopProlongedMonitor();
        _cts.Cancel();
        _cts.Dispose();
    }
}
